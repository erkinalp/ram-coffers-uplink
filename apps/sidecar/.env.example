# Relay uplink endpoint. Use wss:// in production; ws:// is fine for local
# tests and trusted networks (payload frames stay end-to-end encrypted either
# way — only the plaintext hello handshake, with the sidecar name and model
# list, is visible on the wire when using ws://).
RELAY_URL=wss://relay.example.com/uplink
# RELAY_URL=ws://relay:8080/uplink
# Sidecar name as created in the relay admin UI.
SIDECAR_NAME=coffer-01
# Pre-shared key shown once when the sidecar was created in the admin UI.
PSK=rc_psk_...
# Which RAM Coffers upstream this sidecar speaks to:
#   http — an inference service on the coffer host (llama-server or Ollama-compatible)
#   p3xc — a PS3/P3XC expert node, subcluster or layer coordinator
#   both — HTTP for generation, P3XC for the /coffer/v1 cluster routes
UPSTREAM=http
# COFFER_URL=http://localhost:8080
# P3XC_HOST=127.0.0.1
# P3XC_PORT=5920
# P3XC_TIMEOUT_MS=30000
# Models to advertise; required for UPSTREAM=p3xc, optional otherwise.
# MODELS=deepseek-v3-mxfp4,qwen3-30b-a3b
