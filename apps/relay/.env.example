# Token for the admin dashboard login (min 16 characters).
ADMIN_TOKEN=change-me-to-a-long-random-string
# Secret used to sign the admin session cookie (min 32 characters).
SESSION_SECRET=change-me-to-an-even-longer-random-string
# PORT=8080
# DATABASE_PATH=./data/relay.db
# Initial default for statistics; the admin GUI toggle overrides this once set.
# STATS_ENABLED=false
# Comma-separated CORS origins; empty = same-origin only.
# ALLOWED_ORIGINS=https://uplink.example.com
# WEB_ROOT=./apps/relay/web/dist
