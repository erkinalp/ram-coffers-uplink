{
  "name": "ram-coffers-uplink",
  "version": "0.1.0",
  "private": true,
  "description": "Expose a RAM Coffers node or PS3 expert cluster through a VPS relay.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
